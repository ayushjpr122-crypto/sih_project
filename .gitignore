# Total size is small (~9 MB) and every file is under GitHub's 100 MB limit.
experiments/metrics/*
!experiments/metrics/.gitkeep
experiments/results/*
!experiments/results/.gitkeep
*.parquet
!data/processed/ml_dataset.parquet
*.csv
!data/ports/*.csv
!data/vessels/*.csv
.ipynb_checkpoints/
.agents/

